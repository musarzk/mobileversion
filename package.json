{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "server:dev": "ts-node-dev --project server/tsconfig.json --respawn --transpile-only --exit-child server/index.ts",
    "server:local": "ts-node-dev --project server/tsconfig.json --respawn --transpile-only --exit-child server/index.ts",
    "server:stop": "npx kill-port 5000",
    "server:build": "tsc --project server/tsconfig.json",
    "server:start": "node server/dist/index.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "axios": "^1.13.2",
    "expo": "~54.0.30",
    "expo-constants": "^18.0.12",
    "expo-image-picker": "^17.0.10",
    "expo-linking": "^8.0.11",
    "expo-router": "^6.0.21",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.562.0",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-hook-form": "^7.69.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.2.1"
  },
  "devDependencies": {
