    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
