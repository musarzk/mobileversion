# API Configuration
# Copy this to .env and update with your values

# Development - Your local server
EXPO_PUBLIC_API_URL_DEV=http://192.168.100.2:5000/api

# Production - Your deployed server
EXPO_PUBLIC_API_URL_PROD=https://your-production-url.com/api

# For testing APK on local network (optional)
# EXPO_PUBLIC_API_URL_STAGING=http://192.168.100.2:5000/api
